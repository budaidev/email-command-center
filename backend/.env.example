# Local IMAP server (Dovecot / docker-mailserver)
IMAP_HOST=localhost
IMAP_PORT=143

# Paperless-NGX (optional)
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=

# Primary LLM endpoint (checked for availability, used if reachable)
LLM_PRIMARY_BASE_URL=http://localhost:8001/v1
LLM_PRIMARY_MODEL=your-model-name

# Fallback LLM endpoint (used when primary is down)
LLM_FALLBACK_BASE_URL=http://localhost:8002/v1
LLM_FALLBACK_API_KEY=your-api-key
LLM_FALLBACK_MODEL=your-fallback-model

# Vikunja (GTD task management)
VIKUNJA_URL=http://localhost:3456
VIKUNJA_TOKEN=your-vikunja-api-token

# Security — 32-char random string
ENCRYPTION_KEY=change-me-to-a-32-char-random-str

PORT=3002
NODE_ENV=development
